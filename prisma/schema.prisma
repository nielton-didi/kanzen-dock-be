// Prisma schema for Kanzen Dock (general work management)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS - Managed by Supabase Auth, but we store additional profile data
// ============================================================================
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  avatar_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owned_workspaces       Workspace[]          @relation("WorkspaceOwner")
  workspace_members      WorkspaceMember[]
  reported_work_items    WorkItem[]           @relation("WorkItemReporter")
  assigned_work_items    WorkItem[]           @relation("WorkItemAssignee")
  created_projects       Project[]            @relation("ProjectCreator")
  attachments            Attachment[]
  work_item_history_logs WorkItemHistory[]
  list_preferences       ListUserPreference[]
  created_lists          List[]               @relation("ListCreator")
  sent_invites           WorkspaceInvite[]    @relation("InviteSender")

  @@map("users")
}

// ============================================================================
// WORKSPACES - Top-level container for projects and team collaboration
// ============================================================================
model Workspace {
  id         String   @id @default(cuid())
  name       String
  owner_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner    User              @relation("WorkspaceOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  members  WorkspaceMember[]
  invites  WorkspaceInvite[]
  projects Project[]

  @@index([owner_id])
  @@map("workspaces")
}

// ============================================================================
// WORKSPACE_MEMBERS - Join table for workspace collaboration
// Role: "owner", "admin", "member"
// ============================================================================
model WorkspaceMember {
  id           String   @id @default(cuid())
  workspace_id String
  user_id      String
  role         String   @default("member")
  added_at     DateTime @default(now())
  invited_by   String?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@index([workspace_id])
  @@index([user_id])
  @@map("workspace_members")
}

// ============================================================================
// WORKSPACE_INVITES - Pending invites by email (COLLAB-01)
// One row per pending invite; accepting, declining or revoking deletes it.
// Only the SHA-256 of the link token is stored; the raw token is returned once
// (on create/resend). Acceptance requires being logged in as `email`.
// ============================================================================
model WorkspaceInvite {
  id           String   @id @default(cuid())
  workspace_id String
  email        String // lowercased
  role         String   @default("member") // "admin" | "member"
  token_hash   String   @unique
  invited_by   String?
  created_at   DateTime @default(now())
  expires_at   DateTime

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  inviter   User?     @relation("InviteSender", fields: [invited_by], references: [id], onDelete: SetNull)

  @@unique([workspace_id, email])
  @@index([email])
  @@map("workspace_invites")
}

// ============================================================================
// PROJECTS - Tied to exactly 1 workspace
// ============================================================================
model Project {
  id           String   @id @default(cuid())
  name         String
  workspace_id String
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator   User      @relation("ProjectCreator", fields: [created_by], references: [id], onDelete: Restrict)
  lists     List[]

  @@index([workspace_id])
  @@index([created_by])
  @@map("projects")
}

// ============================================================================
// LISTS - Sits between Project and WorkItem (Workspace -> Project -> List -> WorkItem)
// A list is a plain container; its statuses and custom fields shape its work items.
// ============================================================================
model List {
  id         String   @id @default(cuid())
  name       String
  project_id String
  // The member who created the list manages it like an admin. Passes to the
  // workspace owner when that member leaves or is removed.
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  project          Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  creator          User?                @relation("ListCreator", fields: [created_by], references: [id], onDelete: SetNull)
  work_items       WorkItem[]
  statuses         Status[]
  fields           FieldDefinition[]
  user_preferences ListUserPreference[]

  @@index([project_id])
  @@index([created_by])
  @@map("lists")
}

// ============================================================================
// STATUSES - Per-list, user-customizable work item statuses, grouped into 4 fixed
// categories. Category is a real enum (unlike everything else in this schema)
// because it is genuinely fixed and must never be user-editable; name/color
// stay String since those ARE user-editable. Ordering within a list is
// (category, position) — category sorts by declaration order in Postgres.
// ============================================================================
enum StatusCategory {
  not_started
  active
  done
  closed
}

model Status {
  id         String         @id @default(cuid())
  list_id    String
  name       String
  color      String // key into the fixed frontend palette, e.g. "blue", "red"
  category   StatusCategory
  position   Int // ordering within (list_id, category)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  list       List       @relation(fields: [list_id], references: [id], onDelete: Cascade)
  work_items WorkItem[]

  @@unique([list_id, category, position])
  @@unique([list_id, name])
  @@index([list_id])
  @@map("statuses")
}

// ============================================================================
// WORK_ITEMS - Core entity, belongs to a List
// ============================================================================
model WorkItem {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  list_id       String
  status_id     String
  priority      String    @default("none") // urgent, high, medium, low, none
  start_date    DateTime? @db.Date
  due_date      DateTime? @db.Date
  assigned_to   String?
  reported_by   String
  // Custom field values keyed by FieldDefinition id. Validated only in the API
  // (src/custom-fields/custom-field-values.ts) and always updated as a partial
  // merge (`custom_fields || patch`), never read-modify-write of the whole object.
  custom_fields Json      @default("{}")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  list        List              @relation(fields: [list_id], references: [id], onDelete: Cascade)
  status      Status            @relation(fields: [status_id], references: [id], onDelete: Restrict)
  assignee    User?             @relation("WorkItemAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  reporter    User              @relation("WorkItemReporter", fields: [reported_by], references: [id], onDelete: Restrict)
  attachments Attachment[]
  history     WorkItemHistory[]

  @@index([list_id])
  @@index([status_id])
  @@index([assigned_to])
  @@index([reported_by])
  @@index([custom_fields(ops: JsonbPathOps)], type: Gin)
  @@map("work_items")
}

// ============================================================================
// FIELD_DEFINITIONS - Per-list custom fields (see product-requirements D2).
// kind: text, number, dropdown, multi_select, date, person, checkbox, url.
// options: `[{ id, label, color }]` for dropdown / multi_select, `[]` otherwise.
// Kind is fixed after creation; values live in WorkItem.custom_fields.
// Deleting a field only sets deleted_at (recoverable): its values stay in
// custom_fields, and it's treated as unknown until restored. Names are unique
// among a list's active fields only (partial unique index).
// ============================================================================
model FieldDefinition {
  id         String    @id @default(cuid())
  list_id    String
  name       String
  kind       String
  options    Json      @default("[]")
  position   Int // ordering within the list's active fields
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  list List @relation(fields: [list_id], references: [id], onDelete: Cascade)

  @@unique([list_id, name], where: raw("deleted_at IS NULL"))
  @@index([list_id])
  @@map("field_definitions")
}

// ============================================================================
// LIST_USER_PREFERENCES - One user's personal view settings for one list (D6).
// Not shared: each member picks their own. row_field_ids = custom fields shown
// as columns in list rows, in display order (max 3, validated in the API).
// Ids of fields deleted later stay here and are dropped on read, so a restored
// field comes back as a column.
// ============================================================================
model ListUserPreference {
  list_id       String
  user_id       String
  row_field_ids String[] @default([])
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  list List @relation(fields: [list_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([list_id, user_id])
  @@index([user_id])
  @@map("list_user_preferences")
}

// ============================================================================
// ATTACHMENTS - File uploads for work items (images, documents, etc.)
// ============================================================================
model Attachment {
  id           String   @id @default(cuid())
  work_item_id String
  file_url     String
  file_name    String
  file_size    Int?
  file_type    String?
  uploaded_by  String
  uploaded_at  DateTime @default(now())

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)
  uploader  User     @relation(fields: [uploaded_by], references: [id], onDelete: Restrict)

  @@index([work_item_id])
  @@index([uploaded_by])
  @@map("attachments")
}

// ============================================================================
// WORK_ITEM_HISTORY - Complete audit trail of all changes
// ============================================================================
model WorkItemHistory {
  id           String   @id @default(cuid())
  work_item_id String
  field_name   String // created, title, description, status, priority, start_date, due_date, assigned_to, or cf:<field definition id>
  old_value    String?  @db.Text
  new_value    String?  @db.Text
  changed_by   String
  changed_at   DateTime @default(now())

  work_item WorkItem @relation(fields: [work_item_id], references: [id], onDelete: Cascade)
  changer   User     @relation(fields: [changed_by], references: [id], onDelete: Restrict)

  @@index([work_item_id])
  @@index([changed_by])
  @@index([changed_at])
  @@map("work_item_history")
}
