// Prisma schema for Kanzen Dock (bug tracking app)
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// USERS - Managed by Supabase Auth, but we store additional profile data
// ============================================================================
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  avatar_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owned_workspaces  Workspace[]       @relation("WorkspaceOwner")
  workspace_members WorkspaceMember[]
  reported_issues   Issue[]           @relation("IssueReporter")
  assigned_issues   Issue[]           @relation("IssueAssignee")
  created_projects  Project[]         @relation("ProjectCreator")
  attachments       Attachment[]
  issue_history_logs IssueHistory[]

  @@map("users")
}

// ============================================================================
// WORKSPACES - Top-level container for projects and team collaboration
// ============================================================================
model Workspace {
  id         String   @id @default(cuid())
  name       String
  owner_id   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner    User              @relation("WorkspaceOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  members  WorkspaceMember[]
  projects Project[]

  @@index([owner_id])
  @@map("workspaces")
}

// ============================================================================
// WORKSPACE_MEMBERS - Join table for workspace collaboration
// Role: "owner", "admin", "member"
// ============================================================================
model WorkspaceMember {
  id           String   @id @default(cuid())
  workspace_id String
  user_id      String
  role         String   @default("member")
  added_at     DateTime @default(now())
  invited_by   String?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
  @@index([workspace_id])
  @@index([user_id])
  @@map("workspace_members")
}

// ============================================================================
// PROJECTS - Tied to exactly 1 workspace
// ============================================================================
model Project {
  id           String   @id @default(cuid())
  name         String
  workspace_id String
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  creator   User      @relation("ProjectCreator", fields: [created_by], references: [id], onDelete: Restrict)
  issues    Issue[]

  @@index([workspace_id])
  @@index([created_by])
  @@map("projects")
}

// ============================================================================
// ISSUES (Bugs/Tasks) - Core entity
// ============================================================================
model Issue {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  project_id  String
  status      String   @default("open") // open, in_progress, resolved, closed, wont_fix
  severity    String   @default("medium") // critical, high, medium, low
  priority    String   @default("medium") // high, medium, low
  assigned_to String?
  reported_by String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  project     Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  assignee    User?          @relation("IssueAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)
  reporter    User           @relation("IssueReporter", fields: [reported_by], references: [id], onDelete: Restrict)
  attachments Attachment[]
  history     IssueHistory[]

  @@index([project_id])
  @@index([assigned_to])
  @@index([reported_by])
  @@map("issues")
}

// ============================================================================
// ATTACHMENTS - File uploads for issues (images, documents, etc.)
// ============================================================================
model Attachment {
  id          String   @id @default(cuid())
  issue_id    String
  file_url    String
  file_name   String
  file_size   Int?
  file_type   String?
  uploaded_by String
  uploaded_at DateTime @default(now())

  issue    Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaded_by], references: [id], onDelete: Restrict)

  @@index([issue_id])
  @@index([uploaded_by])
  @@map("attachments")
}

// ============================================================================
// ISSUE_HISTORY - Complete audit trail of all changes
// ============================================================================
model IssueHistory {
  id         String   @id @default(cuid())
  issue_id   String
  field_name String // title, description, status, priority, assigned_to, severity
  old_value  String?  @db.Text
  new_value  String?  @db.Text
  changed_by String
  changed_at DateTime @default(now())

  issue   Issue @relation(fields: [issue_id], references: [id], onDelete: Cascade)
  changer User  @relation(fields: [changed_by], references: [id], onDelete: Restrict)

  @@index([issue_id])
  @@index([changed_by])
  @@index([changed_at])
  @@map("issue_history")
}
