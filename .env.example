# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase PostgreSQL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public&sslmode=require

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=issue-attachments

# JWT Secret (for NestJS JWT validation)
JWT_SECRET=your-super-secret-jwt-key

# App
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Auto-run migrations on startup
RUN_SYNC=true
